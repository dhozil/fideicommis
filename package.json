{
  "name": "fideicommis",
  "version": "0.6.0",
  "private": true,
  "description": "An autonomous trust on GenLayer, and the reader that audits it.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test:integration": "python -m pytest tests/integration -v",
    "glsim": "python tools/run_glsim_windows.py --port 4000 --validators 5 --no-browser",
    "check:docs": "python check_docs.py",
    "check:layout": "python check_layout.py",
    "check": "python check_docs.py && python check_layout.py && python check_bundle_guard.py"
  },
  "engines": {
    "node": ">=20"
  }
}
