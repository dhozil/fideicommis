# GenLayer accounts used by gltest on fee-charging networks.
# localnet and studionet come pre-funded with local accounts, so these are only
# needed when running against testnet Bradbury or Asimov.
#
# Fund a Bradbury address first: https://testnet-faucet.genlayer.foundation/
ACCOUNT_PRIVATE_KEY_1=

# Only required if the node validates against a real inference provider.
OPENAI_API_KEY=
HEURIST_API_KEY=

# The reader. NEXT_PUBLIC_FEATURED_TRUST is the address the landing page and the
# directory feature, so a deployment can point at its own trust without a code
# change. It defaults to the reference trust in web/src/lib/registry.ts, which is
# where the whole directory lives, and which no deployment needs to set.
NEXT_PUBLIC_FEATURED_TRUST=
